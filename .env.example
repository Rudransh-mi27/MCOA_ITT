# ==========================================
# LPG Guard System - Environment Configuration
# Track 2: Alert Integration Engine (.env.example)
# ==========================================

# 1. Pushover Emergency Siren Configuration
PUSHOVER_USER_KEY=your_pushover_user_key_here
PUSHOVER_APP_TOKEN=your_pushover_app_token_here

# 2. Textbee Free SMS Gateway Configuration
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_device_id_here

# 3. Emergency Contact Phone Number
ALERT_PHONE_NUMBER=+919876543210

# 4. Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
